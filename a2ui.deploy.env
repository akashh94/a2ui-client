# a2ui-client deployment config — office environment.
# Sourced by deploy.sh in this directory.
# The personal equivalent lives in deploy.personal.env (sourced by
# deploy.personal.sh). Picking which file you source is what picks which
# environment you deploy to.
#
# All values use "${VAR:-default}" so you can override per-run:
#   PROJECT_ID=my-project ./deploy.sh

# --- GCP project / region ---------------------------------------------------
export PROJECT_ID="${PROJECT_ID:-labs-gcp-msls-16495-1782829337}"
export REGION="${REGION:-us-east1}"

# --- Artifact Registry ------------------------------------------------------
export ARTIFACT_REGISTRY="${ARTIFACT_REGISTRY:-akapal-test-repo}"
export ARTIFACT_REGION="${ARTIFACT_REGION:-${REGION}}"

# --- Cloud Run service --------------------------------------------------------
export SERVICE_NAME="${SERVICE_NAME:-a2ui-client}"
# Public base URL of the deployed client. Set after first deploy to the
# printed service URL; also add it to the agent's ALLOW_ORIGINS.
export APP_URL="${APP_URL:-https://a2ui-client-492310803820.${REGION}.run.app}"

# --- Agent this client talks to ---------------------------------------------
# The a2ui-agent service this client discovers/renders. Injected into the
# image at build time (see Dockerfile AGENT_URL build arg); overridable at
# runtime with /?agent=<url>.
export AGENT_URL="${AGENT_URL:-https://a2ui-agent-492310803820.${REGION}.run.app}"
